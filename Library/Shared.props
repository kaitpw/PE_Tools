<Project>
  <ItemGroup>
    <!-- IMPORTANT: Include all .cs files under SharedLibrary/ recursively -->
    <Compile Include="$(MSBuildThisFileDirectory)\**\*.cs" />

    <!-- WPF: Include XAML files as Page items for proper compilation -->
    <!-- NOTE: Link metadata MUST be lowercase to match the pack URIs generated by the XAML compiler.
         The XAML compiler generates lowercase URIs (e.g., /assembly;component/peui/components/palette.xaml)
         but without explicit Link, resources embed with original casing (PeUi/Components/Palette.xaml).
         This mismatch causes intermittent "does not have a resource identified by URI" errors in Revit. -->
    <Page Include="$(MSBuildThisFileDirectory)\**\*.xaml" 
          Generator="MSBuild:Compile" />

    <!-- WPF: Exclude XAML code-behind files from Page compilation -->
    <Compile Update="$(MSBuildThisFileDirectory)\**\*.xaml.cs" />
  </ItemGroup>

  <!-- CRITICAL: Force lowercase Link paths for all XAML files to match XAML compiler's pack URI generation.
       This Target runs before MarkupCompilePass1 to ensure BAML resources are embedded with lowercase paths. -->
  <Target Name="ForceLowercaseXamlLinks" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <Page Update="@(Page)">
        <Link>$([System.String]::new('%(RecursiveDir)%(Filename)%(Extension)').ToLowerInvariant())</Link>
      </Page>
    </ItemGroup>
  </Target>
</Project>