<Border x:Class="AddinPaletteSuite.Core.Ui.SelectableListViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Background="Transparent">
    <Grid x:Name="ContentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Image x:Name="IconImage" 
               Grid.Column="0"
               VerticalAlignment="Center"/>
        
        <Grid x:Name="TextGrid" 
              Grid.Column="1"
              VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ui:TextBlock x:Name="PrimaryText" 
                          Grid.Row="0"
                          Style="{DynamicResource BodyStrongTextBlockStyle}"
                          TextTrimming="CharacterEllipsis"
                          Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
            
            <ui:TextBlock x:Name="SecondaryText" 
                          Grid.Row="1"
                          Style="{DynamicResource CaptionTextBlockStyle}"
                          TextTrimming="CharacterEllipsis"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        
        <Border x:Name="PillBorder" 
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Background="{ui:ThemeResource ControlAltFillColorTertiaryBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                Opacity="0.7">
            <ui:TextBlock x:Name="PillText"
                          Style="{DynamicResource CaptionTextBlockStyle}"
                          FontWeight="Medium"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</Border>