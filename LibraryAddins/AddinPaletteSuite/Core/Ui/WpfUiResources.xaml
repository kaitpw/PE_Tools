<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Merge Wpf.Ui base theme and control dictionaries -->
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>

    <!-- NOTE: Colors, fonts, padding, and spacing are now managed in ThemeManager.cs -->
    <!-- This file only contains WPF.UI theme dictionaries -->
    <!-- Complex styles like MenuItem and ContextMenu should be applied programmatically when needed -->
</ResourceDictionary>